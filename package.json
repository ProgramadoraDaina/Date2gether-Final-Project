{
  "name": "date2gether",
  "version": "0.0.1",
  "description": "Date2gether - clon de Google Meet (proyecto final). Backend con NestJS, Socket.io y Drizzle ORM.",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @date2gether/shared build && nest build",
    "postinstall": "pnpm --filter @date2gether/shared build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "admin:promote": "node scripts/promote-admin.mjs",
    "dev:client": "pnpm --filter client dev",
    "build:client": "pnpm --filter client build",
    "start:client": "pnpm --filter client start",
    "check:client": "pnpm --filter client lint && pnpm --filter client typecheck",
    "test:client": "pnpm --filter client test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:e2e:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:e2e:db:migrate": "cross-env DATABASE_URL=postgresql://test:test@localhost:5433/date2gether_test drizzle-kit migrate",
    "test:e2e:setup": "pnpm test:e2e:db:up && pnpm test:e2e:db:migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@date2gether/shared": "workspace:*",
    "@google/genai": "^3.6.1",
    "@nestjs/common": "^12.0.4",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.4",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/platform-socket.io": "^12.0.4",
    "@nestjs/swagger": "12.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.0.4",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.2",
    "drizzle-orm": "^0.45.3",
    "helmet": "^8.3.0",
    "livekit-server-sdk": "2.19.2",
    "music-metadata": "12.2.1",
    "nodemailer": "^7.0.13",
    "postgres": "^3.4.9",
    "reflect-metadata": "0.2.2",
    "sharp": "0.35.5",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.2.0",
    "@playwright/test": "^1.64.1",
    "@swc/core": "^1.16.22",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^7.0.12",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
