# Copiar este archivo a ".env" y ajustar si hace falta

# Cadena de conexión a Postgres (coincide con docker-compose.yml por defecto)
DATABASE_URL=

# Puerto donde corre el servidor NestJS
PORT=3001

# Origen permitido para CORS (REST y WebSocket). Usar "*" en desarrollo.
CORS_ORIGIN=*

# Secretos para firmar JWT (access y refresh deben ser distintos). Generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Duración de los tokens (formato aceptado por jsonwebtoken: "15m", "7d", etc.)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Región de AWS para Chime SDK (videollamadas). Las credenciales se toman de la cadena por defecto del SDK de AWS (variables AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, perfil de ~/.aws, o rol IAM), no de este archivo.
AWS_REGION=us-east-1
