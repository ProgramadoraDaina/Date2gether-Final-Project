# Copiar este archivo a ".env" y ajustar si hace falta

# Cadena de conexión a Postgres (coincide con docker-compose.yml por defecto)
DATABASE_URL=

# Puerto donde corre el servidor NestJS
PORT=3001

# Origen permitido para CORS (REST y WebSocket). Usar "*" en desarrollo.
CORS_ORIGIN=*

# Secretos para firmar JWT (access y refresh deben ser distintos). Generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Duración de los tokens (formato aceptado por jsonwebtoken: "15m", "7d", etc.)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Región seleccionada del proyecto AWS.
AWS_REGION=us-east-2
# Desarrollo local: sesión temporal creada con aws login --profile date2gether.
# En AWS, omitir AWS_PROFILE para utilizar el rol del servicio.
AWS_PROFILE=date2gether
# Mantener false hasta confirmar acceso a Chime SDK y sus condiciones de cobro.
# El plan FREE del nuevo AWS experience NO admite Chime SDK.
AWS_CHIME_ENABLED=false
# El endpoint Meetings no existe en us-east-2. Requiere acceso a us-east-1.
AWS_CHIME_REGION=us-east-1
# Los medios sí pueden procesarse en la región seleccionada del proyecto.
AWS_CHIME_MEDIA_REGION=us-east-2
