# Copiar este archivo a ".env" y ajustar si hace falta

# Cadena de conexión a Postgres (coincide con docker-compose.yml por defecto)
DATABASE_URL=

# Puerto donde corre el servidor NestJS
PORT=3001

# Origen permitido para CORS (REST y WebSocket). Obligatorio; no se admite "*" (el servidor no arranca).
CORS_ORIGIN=http://localhost:3002

# Secretos para firmar JWT (access y refresh deben ser distintos). Generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Duración de los tokens (formato aceptado por jsonwebtoken: "15m", "7d", etc.)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Servidor LiveKit local. En EC2 usar la URL wss:// y las claves generadas allí.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-for-local-development-only-32chars
MAX_ROOM_PARTICIPANTS=6

# Mini salas dentro de una llamada (breakout rooms). Tope simultaneo por
# llamada, validado fail-fast (entero 0-3; default 3 si no esta definida).
# El valor real de produccion queda en 0 (feature apagada) hasta que la
# Fase 8 del cambio breakout-rooms autorice subirlo a 3 tras la prueba de
# carga bloqueante (openspec/changes/breakout-rooms/tasks.md, Fase 7.4/8.4).
MAX_BREAKOUT_ROOMS=3

# Key beta gratis en https://developers.giphy.com (100 búsquedas/hora)
GIPHY_API_KEY=

# Gratis en Google Cloud Console: habilitar "YouTube Data API v3" y crear una clave (~100 búsquedas/día)
YOUTUBE_API_KEY=


# "Client secret/Api key" de https://freesound.org/apiv2/apply
FREESOUND_API_KEY=

GEMINI_API_KEY=

# Optional: password reset emails (Gmail: account + app password)
SMTP_USER=
SMTP_PASS=
APP_URL=http://localhost:3002