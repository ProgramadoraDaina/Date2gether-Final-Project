# Copiar este archivo a ".env" y ajustar si hace falta

# Cadena de conexión a Postgres (coincide con docker-compose.yml por defecto)
DATABASE_URL=

# Puerto donde corre el servidor NestJS
PORT=3001

# Origen permitido para CORS (REST y WebSocket). Usar "*" en desarrollo.
CORS_ORIGIN=*

# Secretos para firmar JWT (access y refresh deben ser distintos). Generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Duración de los tokens (formato aceptado por jsonwebtoken: "15m", "7d", etc.)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Servidor LiveKit local. En EC2 usar la URL wss:// y las claves generadas allí.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-for-local-development-only-32chars
MAX_ROOM_PARTICIPANTS=6
